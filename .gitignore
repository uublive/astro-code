node_modules/
*.log
.DS_Store
# bin/ holds our CLI — override the global gitignore that excludes bin/
!bin/
!bin/**
# transient state — never commit locks or temp writes
.astrocode/.lock/
**/*.tmp-*

# python bytecode from the kit tools (kit_run_local.py imports kit_test.py)
__pycache__/
*.pyc

# astro-code: per-copy CONVENTIONS.md sync baseline — local state, never shared.
# Committing it would hand every clone a baseline it never actually synced.
.astrocode/.conventions-synced

# Python bytecode from the vendored kit tools under examples/
__pycache__/
*.pyc
