{
  "version": 1,
  "max_concurrent_agents": 6,
  "use_worktrees": true,
  "registry_branch": "astro-registry",
  "registry_remote": "origin",
  "models": {
    "_comment": "Per-role model tier: opus | sonnet. Switch all at once with `ac models max|balanced|fast`. Remove a role to inherit the session model.",
    "planner": "opus",
    "researcher": "sonnet",
    "executor": "sonnet",
    "verifier": "opus",
    "discover": "sonnet"
  },
  "gitflow": {
    "enabled": false,
    "main": "main",
    "develop": "develop",
    "prefixes": { "feature": "feature", "release": "release", "hotfix": "hotfix" },
    "pr": "none"
  }
}
