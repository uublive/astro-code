{
  "version": 1,
  "max_concurrent_agents": 6,
  "use_worktrees": true,
  "lean_execution": true,
  "registry_branch": "astro-registry",
  "registry_remote": "origin",
  "models": {
    "_comment": "Per-role model tier: opus | sonnet, except integrator which is haiku (the sole haiku-tier role, ADR-027). Switch all at once with `ac models max|balanced|fast`. Remove a role to inherit the session model.",
    "planner": "opus",
    "researcher": "sonnet",
    "executor": "sonnet",
    "verifier": "opus",
    "discover": "sonnet",
    "integrator": "haiku"
  },
  "gitflow": {
    "enabled": false,
    "main": "main",
    "develop": "develop",
    "prefixes": { "feature": "feature", "release": "release", "hotfix": "hotfix" },
    "pr": "none"
  }
}
